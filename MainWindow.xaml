<ui:FluentWindow x:Class="OptiWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="OptiWin - Centro de Rendimiento y Privacidad para Windows" 
        Height="820" Width="1200"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <!-- ToolTip Estilizado Fluent con Ajuste Automático de Línea (Wrap) -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#181d28"/>
            <Setter Property="Foreground" Value="#f1f5f9"/>
            <Setter Property="BorderBrush" Value="#38bdf8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" 
                                       TextWrapping="Wrap" 
                                       MaxWidth="390"
                                       Foreground="{TemplateBinding Foreground}"
                                       LineHeight="18"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de Navegación Lateral Fluent -->
        <Style x:Key="FluentNavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="navBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Fluent TitleBar -->
            <RowDefinition Height="*"/>
            <!-- Body -->
            <RowDefinition Height="130"/>
            <!-- Terminal Activity Log -->
        </Grid.RowDefinitions>

        <!-- FLUENT TITLEBAR -->
        <ui:TitleBar Grid.Row="0" Title="OptiWin PRO — Optimizador de Windows 11 / 10" Icon="⚡">
            <ui:TitleBar.Header>
                <!-- Quick Metrics in TitleBar -->
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥️ CPU: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="HeaderCpuText" Text="0%" Foreground="#38bdf8" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮 GPU: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="HeaderGpuText" Text="0%" Foreground="#a855f7" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧠 RAM: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="HeaderRamText" Text="0%" Foreground="#10b981" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️ " FontSize="11"/>
                            <TextBlock x:Name="TxtAdminStatus" Text="Admin" Foreground="#10b981" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- WORKSPACE (SIDEBAR + MAIN CONTENT) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <!-- Sidebar -->
                <ColumnDefinition Width="*"/>
                <!-- Views Container -->
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="14,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="PANEL PRINCIPAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="10,0,0,10"/>
                        <RadioButton x:Name="NavDashboard" Content="📊 Tablero (Dashboard)" Style="{StaticResource FluentNavButton}" IsChecked="True" Checked="NavChanged"/>

                        <TextBlock Text="OPTIMIZACIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="10,16,0,10"/>
                        <RadioButton x:Name="NavGaming" Content="⚡ Rendimiento &amp; Gaming" Style="{StaticResource FluentNavButton}" Checked="NavChanged"/>
                        <RadioButton x:Name="NavPrivacy" Content="🛡️ Privacidad &amp; Telemetría" Style="{StaticResource FluentNavButton}" Checked="NavChanged"/>
                        <RadioButton x:Name="NavDns" Content="🌐 Red &amp; Servidores DNS" Style="{StaticResource FluentNavButton}" Checked="NavChanged"/>
                        <RadioButton x:Name="NavStartup" Content="🚀 Inicio &amp; Bloatware" Style="{StaticResource FluentNavButton}" Checked="NavChanged"/>

                        <TextBlock Text="HERRAMIENTAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="10,16,0,10"/>
                        <RadioButton x:Name="NavCleaner" Content="🧹 Limpieza de Disco" Style="{StaticResource FluentNavButton}" Checked="NavChanged"/>
                        <RadioButton x:Name="NavRam" Content="🧠 Liberador de RAM" Style="{StaticResource FluentNavButton}" Checked="NavChanged"/>
                    </StackPanel>

                    <!-- Sidebar Footer Actions -->
                    <StackPanel Grid.Row="1">
                        <ui:Button Content="Crear Punto Restauración" Appearance="Secondary" Icon="{ui:SymbolIcon ShieldCheckmark24}" Click="BtnCreateRestorePoint_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                        <ui:Button Content="Actualizar Estado" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="BtnRefreshStatus_Click" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VIEWS CONTAINER -->
            <Grid Grid.Column="1" Margin="24,18,24,16">

                <!-- ================= VISTA 0: DASHBOARD ================= -->
                <Grid x:Name="ViewDashboard" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ACCIONES MASIVAS: PERFILES RÁPIDOS EN 1 CLIC -->
                    <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="⚡ PERFILES DE OPTIMIZACIÓN EN 1 CLIC" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <ui:Button Content="Modo Gaming" Appearance="Danger" Icon="{ui:SymbolIcon Flash24}" Margin="0,0,10,0" Click="BtnProfileGaming_Click" 
                                           ToolTip="Activa plan de energía Ultimate Performance, GPU Priority 8, Network Throttling desactivado, vacía RAM y asigna DNS Cloudflare."/>
                                
                                <ui:Button Content="Modo Trabajo" Appearance="Primary" Icon="{ui:SymbolIcon Briefcase24}" Margin="0,0,10,0" Click="BtnProfileWork_Click"
                                           ToolTip="Modo equilibrado: búsqueda local instantánea sin Bing, soporte de rutas largas (>260 caracteres), telemetría bloqueada y DNS Google."/>
                                
                                <ui:Button Content="Modo Creación" Appearance="Secondary" Icon="{ui:SymbolIcon Video24}" Margin="0,0,10,0" Click="BtnProfileCreator_Click"
                                           ToolTip="Máximo procesamiento de CPU/GPU, vaciado de RAM previo a renders y cierre rápido de procesos colgados."/>
                                
                                <ui:Button Content="Restaurar Fábrica" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowReset24}" Click="BtnProfileRestore_Click"
                                           ToolTip="Devuelve todos los ajustes al estándar original de Windows y DNS automático por DHCP."/>
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <!-- HARDWARE METRICS -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 3 METRIC CARDS: CPU, GPU, RAM -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CPU -->
                                <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="🖥️ Procesador (CPU)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="DashCpuPercent" Text="0%" FontSize="18" FontWeight="Bold" Foreground="#38bdf8" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="PbDashCpu" Value="0" Maximum="100" Height="6" Margin="0,4,0,12"/>
                                        <TextBlock x:Name="DashCpuName" Text="Cargando procesador..." FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" MaxHeight="34"/>
                                    </StackPanel>
                                </ui:Card>

                                <!-- GPU -->
                                <ui:Card Grid.Column="1" Margin="4,0,4,0" Padding="16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="🎮 Tarjeta Gráfica (GPU)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="DashGpuPercent" Text="0%" FontSize="18" FontWeight="Bold" Foreground="#a855f7" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="PbDashGpu" Value="0" Maximum="100" Height="6" Foreground="#a855f7" Margin="0,4,0,12"/>
                                        <TextBlock x:Name="DashGpuCardName" Text="Cargando GPU..." FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" MaxHeight="34"/>
                                    </StackPanel>
                                </ui:Card>

                                <!-- RAM -->
                                <ui:Card Grid.Column="2" Margin="8,0,0,0" Padding="16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="🧠 Memoria RAM" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="DashRamPercent" Text="0%" FontSize="18" FontWeight="Bold" Foreground="#10b981" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="PbDashRam" Value="0" Maximum="100" Height="6" Foreground="#10b981" Margin="0,4,0,12"/>
                                        <TextBlock x:Name="DashRamDetails" Text="Uso: 0 GB / 0 GB" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </ui:Card>
                            </Grid>

                            <!-- ALL DISKS STORAGE SECTION -->
                            <Border Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="💾 UNIDADES DE ALMACENAMIENTO (TODOS LOS DISCOS DETECTADOS)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>
                                    
                                    <ItemsControl x:Name="ListAllDisks">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Card Margin="4,0,4,8" Padding="16">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,8">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding UsageBadge}" FontSize="16" FontWeight="Bold" Foreground="{Binding StatusColor}" HorizontalAlignment="Right"/>
                                                        </Grid>

                                                        <ProgressBar Value="{Binding UsagePercent}" Maximum="100" Height="6" Foreground="{Binding StatusColor}" Margin="0,4,0,10"/>

                                                        <TextBlock Text="{Binding FormatDetails}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding DriveType}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </ui:Card>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- SYSTEM SPECS CARD -->
                            <ui:Card Padding="20">
                                <StackPanel>
                                    <TextBlock Text="INFORMACIÓN DEL SISTEMA" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,14"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,14">
                                            <TextBlock Text="Sistema Operativo:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="DashOsName" Text="Microsoft Windows" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                            <TextBlock Text="Tarjeta Gráfica Principal (GPU):" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="DashGpuName" Text="Cargando..." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="Nombre del Equipo:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="DashMachineName" Text="PC" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="Tiempo de Actividad (Uptime):" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="DashUptime" Text="0h 0m" FontSize="14" FontWeight="SemiBold" Foreground="#38bdf8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= VISTA 1: RENDIMIENTO ================= -->
                <Grid x:Name="ViewGaming" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Optimización de Rendimiento y Latencia" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Haz clic en el botón '?' de cada tweak para ver la explicación técnica detallada y las claves que modifica." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListGamingTweaks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,10" Padding="16,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Botón de Información / Explicación ? (Hover y Clic) -->
                                            <ui:Button Grid.Column="1" Appearance="Transparent" Padding="2" Width="32" Height="32" Cursor="Hand" Margin="0,0,14,0"
                                                       Click="BtnInfoTweak_Click" ToolTipService.InitialShowDelay="50" ToolTipService.ShowDuration="60000" ToolTip="{Binding DetailedExplanation}">
                                                <Border Width="24" Height="24" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="12">
                                                    <TextBlock Text="?" FontWeight="Bold" FontSize="13" Foreground="#38bdf8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ui:Button>

                                            <!-- Fluent ToggleSwitch -->
                                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}" Click="TweakToggle_Click"/>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ================= VISTA 2: PRIVACIDAD ================= -->
                <Grid x:Name="ViewPrivacy" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Privacidad y Telemetría de Windows" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Desactiva recolección de diagnósticos, reportes de fallos y rastreo en segundo plano." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListPrivacyTweaks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,10" Padding="16,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Botón de Información / Explicación ? (Hover y Clic) -->
                                            <ui:Button Grid.Column="1" Appearance="Transparent" Padding="2" Width="32" Height="32" Cursor="Hand" Margin="0,0,14,0"
                                                       Click="BtnInfoTweak_Click" ToolTipService.InitialShowDelay="50" ToolTipService.ShowDuration="60000" ToolTip="{Binding DetailedExplanation}">
                                                <Border Width="24" Height="24" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="12">
                                                    <TextBlock Text="?" FontWeight="Bold" FontSize="13" Foreground="#38bdf8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ui:Button>

                                            <!-- Fluent ToggleSwitch -->
                                            <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}" Click="TweakToggle_Click"/>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ================= VISTA 3: RED & DNS ================= -->
                <Grid x:Name="ViewDns" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Configuración Rápida de Servidores DNS" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Cambia al instante los servidores DNS de tus adaptadores de red para reducir la latencia de navegación." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,24"/>

                        <ui:Card Margin="0,0,0,14" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ Cloudflare DNS (1.1.1.1 / 1.0.0.1)" FontSize="15.5" FontWeight="Bold" Foreground="#38bdf8"/>
                                    <TextBlock Text="El servidor DNS público más veloz del mundo. Ideal para gaming y descargas rápidas." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ui:Button Grid.Column="1" Content="Aplicar Cloudflare" Appearance="Primary" Icon="{ui:SymbolIcon Flash24}" Click="BtnDnsCloudflare_Click"/>
                            </Grid>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,14" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🌐 Google Public DNS (8.8.8.8 / 8.8.4.4)" FontSize="15.5" FontWeight="Bold" Foreground="#10b981"/>
                                    <TextBlock Text="Alta estabilidad y compatibilidad global garantizada para entornos de trabajo." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ui:Button Grid.Column="1" Content="Aplicar Google" Appearance="Secondary" Icon="{ui:SymbolIcon Globe24}" Click="BtnDnsGoogle_Click"/>
                            </Grid>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,14" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️ Quad9 DNS Seguro (9.9.9.9 / 149.112.112.112)" FontSize="15.5" FontWeight="Bold" Foreground="#a855f7"/>
                                    <TextBlock Text="Bloquea automáticamente sitios maliciosos, dominios phishing y malware a nivel de red." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ui:Button Grid.Column="1" Content="Aplicar Quad9" Appearance="Secondary" Icon="{ui:SymbolIcon Shield24}" Click="BtnDnsQuad9_Click"/>
                            </Grid>
                        </ui:Card>

                        <ui:Card Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="🔄 Restaurar DNS Automático (DHCP)" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Vuelve a obtener los servidores DNS asignados automáticamente por tu router o proveedor de internet." FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:Button Grid.Column="1" Content="Restaurar DHCP" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowReset24}" Click="BtnDnsDhcp_Click"/>
                            </Grid>
                        </ui:Card>
                    </StackPanel>
                </Grid>

                <!-- ================= VISTA 4: INICIO & BLOATWARE ================= -->
                <Grid x:Name="ViewStartup" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Programas de Inicio y Desinstalación de Bloatware" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Desactiva aplicaciones que ralentizan el arranque y desinstala apps preinstaladas innecesarias." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- PROGRAMAS DE INICIO -->
                        <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="🚀 APPS DE INICIO (REGISTRO)" FontSize="12" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,12"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListStartupItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="1" Content="Quitar" Appearance="Danger" Padding="8,4" FontSize="11" Click="BtnRemoveStartup_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </ui:Card>

                        <!-- DESINSTALADOR BLOATWARE -->
                        <ui:Card Grid.Column="1" Margin="8,0,0,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="🗑️ BLOATWARE PREINSTALADO UWP" FontSize="12" FontWeight="Bold" Foreground="#f59e0b" Margin="0,0,0,12"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListBloatwareItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="1" Content="Desinstalar" Appearance="Danger" Padding="8,4" FontSize="11" Click="BtnUninstallBloatware_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </ui:Card>
                    </Grid>
                </Grid>

                <!-- ================= VISTA 5: LIMPIADOR ================= -->
                <Grid x:Name="ViewCleaner" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Limpieza Profunda de Espacio en Disco" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Elimina archivos temporales acumulados, prefetch, volcados de error y papelera de reciclaje." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,24"/>

                        <ui:Card Padding="28">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <TextBlock x:Name="TxtCleanerSpace" Text="0 MB" FontSize="46" FontWeight="Bold" Foreground="#38bdf8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Espacio identificado para liberar" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                                    <ui:Button x:Name="BtnScanJunk" Content="Escanear Disco" Appearance="Secondary" Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0" Padding="18,10" Click="BtnScanJunk_Click"/>
                                    <ui:Button x:Name="BtnCleanJunk" Content="Limpiar Ahora" Appearance="Success" Icon="{ui:SymbolIcon Broom24}" Padding="18,10" Click="BtnCleanJunk_Click"/>
                                </StackPanel>

                                <Border Grid.Row="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16">
                                    <TextBlock Text="Objetivos de limpieza: %TEMP% de usuario, C:\Windows\Temp, C:\Windows\Prefetch, Crash Dumps, Cachés de Navegadores y Papelera de reciclaje de Windows." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </ui:Card>
                    </StackPanel>
                </Grid>

                <!-- ================= VISTA 6: MEMORIA RAM ================= -->
                <Grid x:Name="ViewRam" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Optimizador de Memoria RAM en Tiempo Real" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Vacía el Working Set de los procesos del sistema para recuperar memoria instantáneamente." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,24"/>

                        <ui:Card Padding="28">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtRamPercentBig" Text="0%" FontSize="52" FontWeight="Bold" Foreground="#38bdf8" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtRamDetails" Text="Uso: 0 GB de 0 GB" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                                <ProgressBar x:Name="PbRamUsage" Width="400" Height="10" Value="0" Maximum="100" Margin="0,0,0,28"/>

                                <ui:Button x:Name="BtnFreeRam" Content="Optimizar y Liberar RAM Ahora" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Click="BtnFreeRam_Click" Padding="24,14" FontSize="14.5"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ACTIVITY LOG FOOTER -->
        <Border Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="📋 REGISTRO DE ACTIVIDAD EN VIVO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLogOutput" IsReadOnly="True" Background="Transparent" Foreground="#a5b4fc" 
                             BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5"
                             TextWrapping="Wrap" Text="Iniciando OptiWin..." TextChanged="TxtLogOutput_TextChanged"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- MODAL FLUIDO DE INFORMACIÓN COMPLETA (AJUSTE AUTOMÁTICO DE TEXTO) -->
        <Grid x:Name="InfoModalOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#cc000000" Visibility="Collapsed">
            <ui:Card Width="580" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Background="#141824">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header -->
                        <RowDefinition Height="*"/>
                        <!-- Scrollable Wrapped Content -->
                        <RowDefinition Height="Auto"/>
                        <!-- Action Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                            <TextBlock Text="💡 " FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModalTweakTitle" Text="Título del Tweak" FontSize="16" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" MaxWidth="480"/>
                        </StackPanel>
                        <ui:Button Appearance="Transparent" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnCloseModal_Click">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ui:Button>
                    </Grid>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="¿QUÉ HACE ESTA OPTIMIZACIÓN?" FontSize="11.5" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ModalTweakExplanation" Text="..." FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                       TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>

                            <TextBlock Text="DETALLES TÉCNICOS (REGISTRO / SERVICIO MODIFICADO)" FontSize="11.5" FontWeight="Bold" Foreground="#f59e0b" Margin="0,0,0,6"/>
                            <Border Background="#0d1117" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <TextBlock x:Name="ModalTweakTechDetails" Text="..." FontSize="12" FontFamily="Consolas, Cascadia Code, Courier New" 
                                           Foreground="#94a3b8" TextWrapping="Wrap" LineHeight="18"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <ui:Button Grid.Row="2" Content="Entendido" Appearance="Primary" HorizontalAlignment="Right" Padding="22,8" Click="BtnCloseModal_Click"/>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>
